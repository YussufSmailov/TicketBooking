server {
    listen ${PORT};
    root /usr/share/nginx/html;
    index index.html;

    # Сайт — одностраничное приложение: любые адреса (/movies/4, /account) отдают index.html,
    # а дальше страницу выбирает React Router. Без этого обновление страницы даёт 404.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Файлы сборки с хешем в имени можно кешировать надолго
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location /images/ {
        expires 7d;
    }
}
